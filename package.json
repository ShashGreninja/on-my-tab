{
  "name": "payment-access-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "demo": "npm run build && node --env-file-if-exists=.env scripts/local.ts",
    "demo:client": "node --env-file-if-exists=.env scripts/demo-client.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test:browser": "npm run build && node scripts/browser-smoke.ts",
    "test": "node --test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@renderinc/sdk": "^1.8.0",
    "ag-studio": "^3.1.0",
    "ag-studio-react": "^3.1.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
